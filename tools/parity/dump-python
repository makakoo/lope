#!/bin/sh
# A1 step 1: capture Python Lope's argparse tree from $LOPE_HOME (default
# ~/.lope) with a scrubbed environment, into tools/parity/out/python.json.
# With --update, also refresh the copy compiled into lope-compat.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
if [ -n "${LOPE_PYTHON_CHECKOUT:-}" ]; then
    [ -f "$LOPE_PYTHON_CHECKOUT/lope/__init__.py" ] || {
        echo "dump-python: LOPE_PYTHON_CHECKOUT='$LOPE_PYTHON_CHECKOUT' does not contain lope/__init__.py" >&2
        exit 1
    }
    lope_home="$LOPE_PYTHON_CHECKOUT"
elif [ -n "${LOPE_HOME:-}" ] && [ -f "$LOPE_HOME/lope/__init__.py" ]; then
    lope_home="$LOPE_HOME"
elif [ -f "$root/lope/__init__.py" ]; then
    lope_home="$root"
else
    lope_home="$HOME/.lope"
fi
mkdir -p "$here/out"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
env -i HOME="$scratch" PATH=/usr/bin:/bin LOPE_HOME="$lope_home" PYTHONDONTWRITEBYTECODE=1 \
    "${LOPE_PYTHON:-/usr/bin/python3}" -I "$here/dump_python.py" > "$here/out/python.json"
compiled="$root/crates/lope-compat/grammar/argparse-python-lope.json"
if [ "${1:-}" = "--update" ]; then
    cp "$here/out/python.json" "$compiled"
    echo "dump-python: updated $compiled"
elif ! "${LOPE_PYTHON:-/usr/bin/python3}" -I -c '
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as f1, open(sys.argv[2], encoding="utf-8") as f2:
        live = json.load(f1)
        compiled = json.load(f2)
except (OSError, ValueError):
    sys.exit(1)
ok = (
    isinstance(live, dict)
    and isinstance(compiled, dict)
    and set(live) == set(compiled)
    and {k: v for k, v in live.items() if k != "python_version"}
    == {k: v for k, v in compiled.items() if k != "python_version"}
)
sys.exit(0 if ok else 1)
' "$here/out/python.json" "$compiled"; then
    echo "dump-python: live argparse tree differs from the grammar compiled into lope-compat" >&2
    echo "dump-python: review the change, then run: tools/parity/dump-python --update" >&2
    diff -u "$compiled" "$here/out/python.json" | head -40 >&2
    exit 1
fi
echo "dump-python: $(grep -m1 '"lope_version"' "$here/out/python.json" | tr -d ' ,') from $lope_home -> tools/parity/out/python.json"
