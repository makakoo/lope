#!/bin/sh
# Regenerate docs/reference/* from a Python Lope tree (default: an export of
# the PL-1 tag). Usage: tools/parity/capture-reference [TAG]
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
default_tag="v2-baseline-0.17.3"
if ! git -C "$HOME/.lope" rev-parse -q --verify "$default_tag" >/dev/null 2>&1; then
  default_tag="lope-baseline-0.17.3"
fi
tag=${1:-$default_tag}
src=$(mktemp -d)
home=$(mktemp -d)
trap 'rm -rf "$src" "$home"' EXIT
git -C "$HOME/.lope" archive "$tag" | tar -x -C "$src"
sha=$(git -C "$HOME/.lope" rev-parse "$tag^{commit}")
ver=$(sed -n 's/^__version__ = "\(.*\)"/\1/p' "$src/lope/__init__.py")
ref="$root/docs/reference"
py() { env -i HOME="$home" PATH=/usr/bin:/bin LOPE_HOME="$src" PYTHONPATH="$src" PYTHONDONTWRITEBYTECODE=1 COLUMNS=100 /usr/bin/python3 "$@"; }

# 1. CLI help for every verb and nested subcommand.
out="$ref/python-lope-$ver-cli-help.txt"
{
  echo "# Python Lope CLI surface — tag $tag ($sha), __version__ $ver"
  echo "# Generated by tools/parity/capture-reference with COLUMNS=100 and a scrubbed env."
  echo "# The machine-readable oracle is crates/lope-compat/grammar/argparse-python-lope.json."
  echo
  echo "################ lope --help"
  py -m lope --help 2>&1 || true
  for verb in $(py -I "$here/dump_python.py" 2>/dev/null | /usr/bin/python3 -c 'import json,sys; d=json.load(sys.stdin); print(" ".join(c["name"] for c in d["parser"]["subcommands"]["commands"]))'); do
    echo; echo "################ lope $verb --help"
    py -m lope "$verb" --help 2>&1 || true
    for sub in $(py -I "$here/dump_python.py" 2>/dev/null | /usr/bin/python3 -c "import json,sys; d=json.load(sys.stdin); c=[c for c in d['parser']['subcommands']['commands'] if c['name']=='$verb'][0]['parser']['subcommands']; print(' '.join(x['name'] for x in c['commands']) if c else '')"); do
      echo; echo "################ lope $verb $sub --help"
      py -m lope "$verb" "$sub" --help 2>&1 || true
    done
  done
} > "$out"
echo "capture-reference: $out ($(wc -l < "$out" | tr -d ' ') lines)"

# 2. Environment variable names referenced in the code.
out="$ref/python-lope-env-vars.txt"
{
  echo "# Environment variables referenced by Python Lope — tag $tag ($sha)"
  echo "# Method: grep -ohE '\\bLOPE_[A-Z0-9_]*[A-Z0-9]\\b|\\bMAKAKOO_[A-Z0-9_]*[A-Z0-9]\\b' lope/**/*.py | sort -u"
  echo "# Names only; occurrences in docstrings are included."
  grep -rohE '\bLOPE_[A-Z0-9_]*[A-Z0-9]\b|\bMAKAKOO_[A-Z0-9_]*[A-Z0-9]\b' "$src/lope" | sort -u
} > "$out"
echo "capture-reference: $out ($(grep -vc '^#' "$out") names)"

# 3. memory.db schema as created by the code at the tag.
out="$ref/python-lope-memory-db-schema.sql"
db="$home/memory.db"
py -c "import sys; sys.path.insert(0, '$src'); from pathlib import Path; from lope.memory import LopeMemory; m = LopeMemory(db_path=Path('$db')); m._connect().close()"
{
  echo "-- Python Lope memory.db schema — tag $tag ($sha)"
  echo "-- Generated by tools/parity/capture-reference: LopeMemory(db_path=...) on an empty file, then .schema"
  echo "-- PRAGMA user_version = $(sqlite3 "$db" 'PRAGMA user_version;')"
  sqlite3 "$db" .schema
} > "$out"
echo "capture-reference: $out"
