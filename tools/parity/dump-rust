#!/bin/sh
# A1 step 2: dump the clap grammar's parse-relevant projection into
# tools/parity/out/rust.json.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
mkdir -p "$here/out"
"$root/scripts/cargo" run -q --manifest-path "$root/Cargo.toml" -p lope-compat --bin lope-parity-dump > "$here/out/rust.json"
echo "dump-rust: clap projection -> tools/parity/out/rust.json"
